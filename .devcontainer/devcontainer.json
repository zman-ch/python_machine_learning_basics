{
    "name": "Python 3.11 with Jupyter and Copilot",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",

    "customizations": {
        "vscode": {
        "extensions": [
            "ms-python.python",
            "ms-toolsai.jupyter",
            "ms-azuretools.vscode-docker",
            "ms-python.autopep8",
            "ms-python.pylint",
            "analytic-signal.preview-pdf",
            "grapecity.gc-excelviewer",
            "github.copilot",
            "github.copilot-chat",
            "mechatroner.rainbow-csv"
        ],
        "settings": {
            "workbench.colorTheme": "Default Dark+",
            "editor.rulers": [80],
            "workbench.iconTheme": "vs-seti"
        }
        }
    },

    "postCreateCommand": "python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.2.2 && python -m pip install -r requirements.txt && python -c \"import torch; print('PyTorch:', torch.__version__)\""
}